# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DB_URL=jdbc:postgresql://localhost:5432/talentlens
DB_USERNAME=talentlens
DB_PASSWORD=talentlens
API_DOCS_ENABLED=true
RESUME_MAX_FILE_SIZE=5MB
BCRYPT_STRENGTH=10
# The account registered with this email becomes an ADMIN who can assign roles.
ADMIN_EMAIL=
# At least 32 random bytes, e.g. `openssl rand -base64 48`. Empty means a new random key on every start.
JWT_SECRET=
JWT_EXPIRATION=1h
JWT_ISSUER=talentlens

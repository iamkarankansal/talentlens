# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DB_URL=jdbc:postgresql://localhost:5432/talentlens
DB_USERNAME=talentlens
DB_PASSWORD=talentlens
API_DOCS_ENABLED=true
RESUME_MAX_FILE_SIZE=5MB
BCRYPT_STRENGTH=10
# The account registered with this email becomes an ADMIN who can assign roles.
ADMIN_EMAIL=
# true: write and AI endpoints need a RECRUITER or ADMIN token.
AUTH_ENFORCED=false
# Failed logins in a row for one email before a temporary lockout (0 turns it off).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=15m
# At least 32 random bytes, e.g. `openssl rand -base64 48`. Empty means a new random key on every start.
JWT_SECRET=
JWT_EXPIRATION=1h
JWT_ISSUER=talentlens
# Cache backend: redis, simple (in-memory, the default) or none. TTL applies to Redis.
CACHE_TYPE=simple
CACHE_TTL=10m
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_HEALTH_ENABLED=false
